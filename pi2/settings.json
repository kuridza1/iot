{
  "device": {
    "pi_id": "PI2",
    "device_name": "Smart garage",
    "location": "Garage",
    "default_simulated": true
  },

  "mqtt": {
    "enabled": true,
    "broker": "localhost",
    "port": 1883,
    "topic_prefix": "iot/smart-house",
    "client_id": "pi2-smart-garage",
    "qos": 1,
    "retain": false,
    "batch_size": 10,
    "flush_interval_sec": 5
  },

  "DS2": {
    "simulated": true,
    "pin": 23,
    "active_high": true
  },

  "BTN": {
    "simulated": true,
    "pin": 24,
    "active_high": true
  },

  "DUS2": {
    "delay_sec": 2.0,
    "simulated": true
  },

  "DPIR2": {
    "delay_sec": 1.5,
    "simulated": true
  },

  "GSG": {
    "delay_sec": 0.5,
    "simulated": true
  },

  "4SD": {
    "simulated": true
  }
}
