{
  "SERVER": {
  "enabled": true,
  "base_url": "http://0.0.0.0:5000",
  "dht3_device": "PI2"
  },
  "device": {
    "pi_id": "PI3",
    "device_name": "SmartRooms",
    "location": "Bedroom/LivingRoom",
    "default_simulated": true
  },
  "mqtt": {
    "enabled": true,
    "broker": "localhost",
    "port": 1883,
    "topic_prefix": "iot/smart-house",
    "client_id": "pi3-smartrooms",
    "qos": 1,
    "retain": false,
    "batch_size": 10,
    "flush_interval_sec": 5
  },

  "DPIR3": {
    "delay_sec": 1.5,
    "simulated": true,
    "pin": 17,
    "pull": "down",
    "active_high": true
  },

  "DHT1": { "delay_sec": 3.0, "simulated": true, "temp_c_start": 22.5, "hum_pct_start": 45.0 },
  "DHT2": { "delay_sec": 3.0, "simulated": true, "temp_c_start": 21.0, "hum_pct_start": 48.0 },

  "IR": { "delay_sec": 0.25, "simulated": true, "burst_prob": 0.06 },

  "BRGB": {
    "simulated": true,
    "pin_r": 17,
    "pin_g": 27,
    "pin_b": 22,
    "active_high": true
  },

  "LCD": {
    "simulated": false,
    "auto_rotate": true,
    "rotate_period_sec": 2.5
  }
}
