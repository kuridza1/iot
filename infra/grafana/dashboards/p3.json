      "targets": [
        {
          "query": "import \"strings\"\r\n\r\nfrom(bucket: \"iot\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) =>\r\n    r._measurement == \"telemetry\" and\r\n    r.device == \"PI3\" and\r\n    r.code == \"BRGB_SET\" and\r\n    r._field == \"value_str\"\r\n  )\r\n  |> map(fn: (r) => ({\r\n      r with\r\n      rr: if strings.containsStr(v: string(v: r._value), substr: \"'r': True\") then 1 else 0,\r\n      gg: if strings.containsStr(v: string(v: r._value), substr: \"'g': True\") then 1 else 0,\r\n      bb: if strings.containsStr(v: string(v: r._value), substr: \"'b': True\") then 1 else 0,\r\n  }))\r\n  |> map(fn: (r) => ({\r\n      _time: r._time,\r\n      _value: r.rr * 4 + r.gg * 2 + r.bb,\r\n      _field: \"BRGB\"          // jedan field da bude jedna serija\r\n  }))\r\n  |> group(columns: [\"_field\"])\r\n  |> sort(columns: [\"_time\"])",
          "refId": "A"
        }
      ],
      "title": "BGRB",
      "type": "state-timeline"
    },
