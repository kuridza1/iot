          "query": "set = from(bucket: \"iot\")\r\n  |> range(start: -6h)\r\n  |> filter(fn: (r) =>\r\n      r._measurement == \"telemetry\" and\r\n      r.device == \"PI2\" and\r\n      r.code == \"4SD_SET\" and\r\n      r._field == \"value_num\"\r\n  )\r\n  |> map(fn: (r) => ({ r with _value: int(v: r._value) }))\r\n\r\nrun = from(bucket: \"iot\")\r\n  |> range(start: -6h)\r\n  |> filter(fn: (r) =>\r\n      r._measurement == \"telemetry\" and\r\n      r.device == \"PI2\" and\r\n      r.code == \"4SD_RUN\" and\r\n      r._field == \"value_bool\"\r\n  )\r\n  |> map(fn: (r) => ({\r\n      r with _value: if r._value then 1 else 0\r\n  }))\r\n\r\nunion(tables: [set, run])\r\n  |> keep(columns: [\"_time\", \"_value\", \"code\"])\r\n",
